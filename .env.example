# ============================================================ MySQL
MYSQL_HOST=localhost
MYSQL_USER=tu_usuario_mysql
MYSQL_PASSWORD=tu_contrasena_mysql
MYSQL_DB=factus
MYSQL_PORT=3306

# ======================================================= Aplicación
# development | production (en production la app no arranca sin los secretos).
APP_ENV=development
# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Carpeta para PDF/XML de facturas en caché y comprobantes de transferencia.
STORAGE_DIR=storage
LOG_LEVEL=INFO

# ==================================================== Autenticación
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
WEBHOOK_RATE_LIMIT=120
WEBHOOK_RATE_WINDOW_SECONDS=60

# ============================================================ Pagos
# Secreto HMAC para la firma de integridad de cada pago (distinto de JWT_SECRET).
PAYMENT_SIGNING_SECRET=
PAYMENT_EXPIRATION_MINUTES=30
PAYMENT_CURRENCY=COP
# wompi = transferencia/tarjeta por Wompi | manual = QR Bre-B + comprobante y datáfono.
PAYMENT_PROVIDER=manual
COMPROBANTE_MAX_BYTES=2000000

# Modo manual (Bre-B)
BREB_LLAVE_COMERCIO=
BREB_NOMBRE_COMERCIO=

# Wompi (https://comercios.wompi.co → Desarrolladores). Usa llaves de prueba en sandbox.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_REDIRECT_URL=

# Job que expira pagos vencidos y libera el stock reservado.
EXPIRATION_JOB_ENABLED=true
EXPIRATION_JOB_INTERVAL_SECONDS=60

# =========================================================== Factus
# Sandbox: https://api-sandbox.factus.com.co | Producción: https://api.factus.com.co
FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=

# ID de un rango activo y vigente de "Factura de Venta" de TU cuenta
# (consúltalo en GET /catalogos/factus/rangos_numeracion después de refrescar).
FACTUS_NUMBERING_RANGE_ID=
# Rango de notas crédito: obligatorio si tu cuenta tiene más de uno activo.
FACTUS_CREDIT_NOTE_NUMBERING_RANGE_ID=
FACTUS_DOCUMENT_TYPE_ID=1
FACTUS_PAYMENT_FORM=1
FACTUS_TRIBUTE_CODE=ZZ
FACTUS_TIMEOUT_SECONDS=30
FACTUS_MAX_RETRIES=3
# En sandbox Factus no envía correos aunque esté en true.
FACTUS_SEND_EMAIL=true
# Método de pago → payment_method_code (tabla oficial: 10 efectivo, 47 transferencia,
# 42 consignación, 48 tarjeta crédito, 49 tarjeta débito).
FACTUS_PAYMENT_METHOD_CODES_JSON={"EFECTIVO":"10","TRANSFERENCIA":"47","TARJETA_CREDITO":"48","TARJETA_DEBITO":"49"}

FACTUS_MUNICIPALITIES_URL=https://developers.factus.com.co/tablas-de-referencia/municipios
FACTUS_UNIT_MEASURES_URL=https://developers.factus.com.co/tablas-de-referencia/unit-measures/
