MYSQL_HOST=localhost
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=factus
MYSQL_PORT=3306

FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=
# Set this to an active numbering range ID from Factus before issuing invoices.
# FACTUS_NUMBERING_RANGE_ID=
FACTUS_DOCUMENT_TYPE_ID=1
FACTUS_PAYMENT_FORM=1
FACTUS_PAYMENT_METHOD_CODE=10
FACTUS_TRIBUTE_CODE=21
# Optional fallback when municipio_departamento cannot be matched.
# FACTUS_DEFAULT_MUNICIPALITY_ID=
FACTUS_MUNICIPALITIES_URL=https://developers.factus.com.co/tablas-de-referencia/municipios
FACTUS_UNIT_MEASURES_URL=https://developers.factus.com.co/tablas-de-referencia/unit-measures/
# Optional explicit overrides. The catalog has two "gramo" codes; GRM is selected.
# "servicio" and "otro" require a suitable code for the product's actual unit.
FACTUS_UNIT_CODES_JSON={"gramos":"GRM","servicio":"","otro":""}
